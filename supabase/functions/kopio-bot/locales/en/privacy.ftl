privacy =
  .summary =
    🔒 Your data:
    Submissions: { $total } total ({ $approved } approved, { $pending } pending)
    Session: { $session }
  .session_active = connected to { $group }
  .session_none = no active session
  .unlink_button = 🔓 Unlink my submissions
  .deleteall_button = 🗑️ Delete all my data
  .unlink_prompt = This will remove your identity from { $count } submission(s). This cannot be undone.
  .deleteall_prompt = ⚠️ This will permanently delete all your data: your submissions will be anonymised, your account and roles will be removed. This cannot be undone.
  .confirm_button = ✅ Confirm
  .cancel_button = ✗ Cancel
  .unlink_success = ✅ Done. Your identity has been removed from { $count } submission(s).
  .deleteall_success = ✅ Done. All your data has been deleted.
  .cancelled = Cancelled.
